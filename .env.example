# Required env vars for Vercel (set these in the Vercel project dashboard)

# Admin login password (shared, single-user).
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random long string used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Vercel Blob read/write token. Created automatically when you add a Blob store to the project,
# OR generate manually: Vercel dashboard -> Storage -> Blob -> .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
